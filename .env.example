# WOG Dump - local configuration template.
# Copy this file to .env and fill in the values you have.
# .env is gitignored: never commit real credentials or keys.

# --- Auth, option 1: captured session from your own traffic ---
# Capture the game client once with mitmproxy and import everything:
#   uv run python scripts/extract_keys.py capture.flows --identity --merge
# or copy the values it prints. See docs/mitm-capture.md.
WOG_AUTH_ID=
WOG_AUTH_SESSION=
# Optional: the API accepts any device id; one is generated when omitted
WOG_DEVICE_ID=

# --- Auth, option 2: game account (email login, fresh session each run) ---
# Create the account in the game client first.
WOG_ACCOUNT_EMAIL=
WOG_ACCOUNT_PASSWORD=

# --- Storage ---
# Per-user SQLite database location (defaults to the OS user data dir)
# WOG_DB_PATH=/home/USER/.local/share/wog_dump/wog_dump.db

# --- Network defaults (current as of the protocol capture, Nov 2026) ---
# WOG_API_BASE_URL=https://eu1.ultimate-disassembly.com/v/query2026.php
# WOG_DATA_BASE_URL=https://data1eu.ultimate-disassembly.com/uni2018
# WOG_GAME_VERSION=2.2.3u9
# WOG_UNITY_VERSION=6000.0.84f1

# --- Rate limiting (seconds between requests; raise on 429 errors) ---
# WOG_API_REQUEST_DELAY=0.5
# WOG_REQUEST_DELAY=0.1

# --- Performance ---
# WOG_MAX_THREADS=4

# --- Live tests ---
# With either auth option filled in, run: pytest -m live
